{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy & Run on Zedboard",
            "type": "shell",
            "command": "scp ${file} zedboard:~/fpga_lab_sprint/python/scripts/${fileBasename} && ssh zedboard 'cd fpga_lab_sprint/python && FPGA_MODEL=ZedBoard sudo -E python3 scripts/${fileBasename}'",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": "build"
        },
        {
            "label": "Download Results from Zedboard",
            "type": "shell",
            "command": "scp -r zedboard:~/fpga_lab_sprint/python/results/ZedBoard/ ${workspaceFolder}/python/results",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": "build"
        },
        {
            "label": "Run Vivado",
            "type": "shell",
            "command": "vivado",
            "args": [
                "-nolog",
                "-nojournal",
                "${input:projectFile_xpr}"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Rebuild Vivado Project",
            "type": "shell",
            "command": "rm -r FPGA/project/* & vivado -nolog -nojournal -mode batch -source FPGA/make_project.tcl ",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ],
    "inputs": [
        {
            "id": "projectFile_xpr",
            "type": "promptString",
            "description": "Enter the Vivado project file path",
            "default": "FPGA/vivado/crypto_kernel_fpga/crypto_kernel_fpga.xpr"
        }
    ]
}
